{
  "name": "ski-rent-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Ski rental workflow demo with shared inventory, reservations, dispatch, intake and SQLite API",
  "scripts": {
    "dev": "python3 scripts/build.py --serve --port 58148",
    "build": "python3 scripts/build.py",
    "check": "python3 scripts/check.py",
    "test": "node --test tests/returns-*.test.cjs tests/notifications.test.cjs tests/notification-runtime.test.cjs tests/workflows-domain.test.cjs tests/workflows-service.test.cjs tests/workflows-api.test.cjs tests/workflows-demo.test.cjs",
    "test:visual": "node scripts/visual-check.cjs",
    "test:returns": "node --test tests/returns-*.test.cjs",
    "test:returns:browser": "node scripts/smoke-returns.cjs",
    "returns:setup": "node scripts/setup-returns-demo.cjs",
    "returns:server": "node server/returns-api.cjs",
    "test:returns:ui": "node scripts/smoke-returns-ui.cjs",
    "test:intake": "node scripts/smoke-intake.cjs",
    "test:navigation": "node scripts/smoke-navigation.cjs",
    "test:rental-board": "node scripts/smoke-rental-board.cjs",
    "test:rental-parity": "node scripts/compare-rental-reference.cjs",
    "test:pwa": "npm run build && node scripts/smoke-pwa.cjs",
    "icons:build": "node scripts/build-app-icons.cjs",
    "test:time-picker": "node scripts/smoke-time-picker.cjs",
    "test:operations": "node scripts/smoke-operations.cjs",
    "test:notifications": "node --test tests/notifications.test.cjs tests/notification-runtime.test.cjs",
    "test:notifications:ui": "node scripts/smoke-notifications.cjs",
    "test:workflows": "node --test tests/workflows-*.test.cjs",
    "test:workflows:unit": "node --test tests/workflows-domain.test.cjs tests/workflows-service.test.cjs tests/workflows-api.test.cjs tests/workflows-demo.test.cjs",
    "test:legacy-ui": "node scripts/smoke.cjs all"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
