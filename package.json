{
  "name": "ski-rent-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Ski rental workflow demo with shared inventory, reservations, dispatch, intake and SQLite API",
  "scripts": {
    "dev": "python3 scripts/build.py --serve --port 58148",
    "build": "python3 scripts/build.py",
    "check": "python3 scripts/check.py",
    "test": "node --test tests/returns-*.test.cjs tests/notifications.test.cjs tests/notification-runtime.test.cjs tests/workflows-*.test.cjs",
    "test:returns": "node --test tests/returns-*.test.cjs",
    "test:returns:browser": "node scripts/smoke-returns.cjs",
    "returns:setup": "node scripts/setup-returns-demo.cjs",
    "returns:server": "node server/returns-api.cjs",
    "test:pwa": "npm run build && node scripts/smoke-pwa.cjs",
    "icons:build": "node scripts/build-app-icons.cjs",
    "test:notifications": "node --test tests/notifications.test.cjs tests/notification-runtime.test.cjs",
    "test:workflows": "node --test tests/workflows-*.test.cjs",
    "test:workflows:unit": "node --test $(ls tests/workflows-*.test.cjs | grep -v workflows-browser)",
    "test:workflows:browser": "node --test tests/workflows-browser.test.cjs",
    "test:pos:operating": "node scripts/smoke-pos-operating.cjs",
    "test:pos:fulfillment": "node scripts/smoke-pos-fulfillment.cjs",
    "test:pos:tickets": "node scripts/smoke-pos-tickets.cjs",
    "test:pos:management": "node scripts/smoke-pos-management.cjs",
    "test:pos:preinput": "node scripts/smoke-pos-preinput.cjs",
    "test:pos:keypad": "node scripts/smoke-pos-keypad.cjs",
    "pos:screens": "node scripts/capture-pos-release.cjs",
    "pos:screens:fulfillment": "node scripts/capture-pos-fulfillment.cjs",
    "pos:screens:driver": "node scripts/capture-pos-driver.cjs",
    "pos:rules": "node scripts/capture-pos-release.cjs && node scripts/check-pos-ui-rules.cjs",
    "pos:backup": "node scripts/backup-workflows.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
